# Cloudflare Pages response headers (docs/DEPLOY.md). Hashed build assets never change; the
# entry files must be revalidated so a new deployment is picked up.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
