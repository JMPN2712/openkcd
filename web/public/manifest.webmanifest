{
  "name": "OpenKCD",
  "short_name": "OpenKCD",
  "description": "Unofficial open-source browser engine for Kingdom Come: Deliverance, running from your own copy of the game.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#17150f",
  "theme_color": "#17150f",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
