/kcd1/
/game/
/extracted/
/assets/
/dump/
/out-assets/
/packages/
*.okpkg
/renders/

# --- Reverse engineering: decompiled output stays in ~/tools/ghidra-out, never here ---
ghidra-out/
*.gzf
*.rep/
*.gpr

# --- Node / build ---
node_modules/
dist/
build/
.vite/
*.tsbuildinfo
coverage/

